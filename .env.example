SECRET_KEY=replace-with-a-secure-random-secret
FLOWGUARD_ENV=development
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_PROXY_SSL_HEADER=false

# Optional external traffic integration.
TOMTOM_API_KEY=

# SQLite is used by project design. Override only if your deployment needs a custom path.
SQLITE_DB_PATH=server/db.sqlite3

# Celery is optional at runtime because selected API flows use sync fallback.
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://

# API throttle and pothole tuning defaults.
THROTTLE_USER_RATE=120/min
THROTTLE_ANON_RATE=60/min
THROTTLE_SENSOR_USER_RATE=30/min
THROTTLE_SENSOR_ANON_RATE=10/min
THROTTLE_ROUTING_RATE=50/min
POTHOLE_Z_THRESHOLD=3.2
POTHOLE_DEBOUNCE_SECONDS=10
POTHOLE_DEVICE_COOLDOWN_SECONDS=60
POTHOLE_CLUSTER_RADIUS_METERS=35.0
POTHOLE_VERIFY_MIN_REPORTS=3
POTHOLE_VERIFY_MIN_DEVICES=2
POTHOLE_WARNING_RADIUS_METERS=500.0
SENSOR_INGEST_RATE_LIMIT=30
SENSOR_INGEST_RATE_PERIOD_SECONDS=60

# Frontend. Leave blank in production when served behind the same origin /api path.
VITE_API_BASE_URL=/api
